From 7725eee0cbc5c2cdcf32d89c85f1d4a404d4b2bc Mon Sep 17 00:00:00 2001
From: "deepak.s" <deepak.s@adlinktech.com>
Date: Wed, 26 Mar 2025 16:34:38 +0530
Subject: [PATCH] LT9611 bridge to support FHD resolution

---
 drivers/gpu/drm/panel/panel-simple.c | 31 ++++++++++++++++++++++++++++
 1 file changed, 31 insertions(+)

diff --git a/drivers/gpu/drm/panel/panel-simple.c b/drivers/gpu/drm/panel/panel-simple.c
index 6e46e55d29a9..78c0fb360545 100644
--- a/drivers/gpu/drm/panel/panel-simple.c
+++ b/drivers/gpu/drm/panel/panel-simple.c
@@ -4572,6 +4572,34 @@ struct panel_desc_dsi {
 	unsigned int lanes;
 };
 
+static const struct drm_display_mode lt9611_panel_mode = {
+       .clock = 148500,
+       .hdisplay = 1920,
+       .hsync_start = 1920 + 88,
+       .hsync_end = 1920 + 88 + 44,
+       .htotal = 1920 + 88 + 44 + 148,
+       .vdisplay = 1080,
+       .vsync_start = 1080 + 4,
+       .vsync_end = 1080 + 4 + 5,
+       .vtotal = 1080 + 4 + 5 + 36,
+};
+
+static const struct panel_desc_dsi lt9611_panel = {
+       .desc = {
+               .modes = &lt9611_panel_mode,
+               .num_modes = 1,
+               .bpc = 8,
+               .size = {
+                       .width = 62,
+                       .height = 110,
+               },
+               .connector_type = DRM_MODE_CONNECTOR_DSI,
+       },
+       .flags = MIPI_DSI_MODE_VIDEO_HSE | MIPI_DSI_MODE_VIDEO | MIPI_DSI_MODE_NO_EOT_PACKET | MIPI_DSI_MODE_VIDEO_SYNC_PULSE,
+       .format = MIPI_DSI_FMT_RGB888,
+       .lanes = 4,
+};
+
 static const struct drm_display_mode auo_b080uan01_mode = {
 	.clock = 154500,
 	.hdisplay = 1200,
@@ -4776,6 +4804,9 @@ static const struct panel_desc_dsi osd101t2045_53ts = {
 
 static const struct of_device_id dsi_of_match[] = {
 	{
+		.compatible = "adlink,lt9611uxc",
+		.data = &lt9611_panel
+	}, {
 		.compatible = "auo,b080uan01",
 		.data = &auo_b080uan01
 	}, {
-- 
2.25.1

