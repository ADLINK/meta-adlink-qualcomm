+			cmd->size += sizeof(MrvlIEtypes_RobustcoexSourceGPIO_t);
+			tlv->header.type =
+				wlan_cpu_to_le16(TLV_TYPE_ROBUSTCOEX);
+			tlv->header.len = wlan_cpu_to_le16(
+				sizeof(MrvlIEtypes_RobustcoexSourceGPIO_t) -
+				sizeof(MrvlIEtypesHeader_t));
