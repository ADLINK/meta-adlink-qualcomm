+	   the module parameters for different chips.
+	c) Uninstall WLAN driver,
+		ifconfig mlanX down
+		rmmod sdxxx
+		rmmod mlan
+#else
+#ifdef SYSKT_MULTI
+	b) Install SDIO bus driver and WLAN driver,
