+typedef enum _WLAN_802_11_NETWORK_TYPE {
+	Wlan802_11FH,
+	Wlan802_11DS,
+	/* Defined as upper bound*/
+	Wlan802_11NetworkTypeMax
+} WLAN_802_11_NETWORK_TYPE;
