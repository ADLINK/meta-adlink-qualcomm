+	/** Buffer pointer */
+	t_u64 buf;
+	/** buffer updated by driver */
+	int used_len;
+	/** buffer sent by application */
+	int total_len;
+} __attribute__((packed)) android_wifi_priv_cmd;
+#else
+typedef struct _android_wifi_priv_cmd {
+	/** Buffer pointer */
+	char *buf;
