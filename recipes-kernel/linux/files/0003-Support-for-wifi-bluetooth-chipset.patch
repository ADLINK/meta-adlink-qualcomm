+		return;
+
+	PRINTM(MMSG, "=== START DRIVER INFO DUMP===");
+	memset(file_name, 0, sizeof(file_name));
+	if (phandle->second_mac)
+		snprintf(file_name, sizeof(file_name), "%s/%s", dir_name,
