+		rmmod mlan
+#else
+#ifdef ORION
+	a) Copy firmware image usb8786.bin | ... to /usr/lib/hotplug/firmware/nxp/
+	   directory, create the directory if it doesn't exist.
+#else
+	a) Copy firmware image usb8766.bin | ... to /lib/firmware/nxp/ directory,
